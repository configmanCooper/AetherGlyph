<?xml version="1.0" encoding="utf-8"?>
<!--
  Production traffic uses HTTPS. Cleartext is enabled so the paid app can connect
  to a manually entered private-LAN host; application URL validation still rejects
  public cleartext origins.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
